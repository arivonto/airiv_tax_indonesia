<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_indonesia_tax" model="ir.ui.view">
            <field name="name">account.move.form.indonesia.tax</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="DJP Faktur Pajak" name="indonesia_faktur_page" invisible="move_type not in ('out_invoice', 'out_refund')">
                        <group>
                            <group string="Nomor Seri Faktur Pajak (NSFP)">
                                <field name="l10n_id_tax_transaction_code"/>
                                <field name="l10n_id_faktur_pajak_number" readonly="1"/>
                                <field name="l10n_id_faktur_date"/>
                                <field name="l10n_id_efaktur_status" widget="badge"/>
                            </group>
                            <group string="Statutory DPP Calculations">
                                <field name="l10n_id_is_dpp_nilai_lain"/>
                                <field name="l10n_id_dpp_factor" invisible="not l10n_id_is_dpp_nilai_lain"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
